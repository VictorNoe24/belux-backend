NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/belux"

JWT_SECRET="replace-with-a-secure-random-secret"
JWT_EXPIRES_IN="15d"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret"
